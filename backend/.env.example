# Copie este arquivo para backend/.env antes de rodar `docker compose up`
# (o docker-compose carrega via env_file e falha se o arquivo nao existir).

# Seguranca — defina um valor forte; sem ele o backend usa o fallback inseguro 'change-me'
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Banco de dados (obrigatoria — o backend nao sobe sem ela).
# No Docker o host e o servico `postgres`; em dev local sem Docker, troque para `localhost`.
DATABASE_URL=postgresql://plataforma:plataforma@postgres:5432/plataforma_cursos

# MinIO (todas tem defaults; estes sao os valores do docker-compose)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos
# Base das URLs publicas dos arquivos (acessada pelo browser)
MINIO_PUBLIC_URL=http://localhost:9000

# Porta da API (opcional, default 4000)
# PORT=4000
