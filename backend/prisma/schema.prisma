generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSOR
  ALUNO
}

enum QuestionType {
  OBJETIVA
  DISSERTATIVA
}

enum SubmissionStatus {
  PENDENTE
  CORRIGIDA
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  signatureUrl String?
  createdAt DateTime @default(now())
  courses   Course[]
  lessonProgresses LessonProgress[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  submissions      AssessmentSubmission[]
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  createdBy   String   @db.Uuid
  assessmentsEnabled           Boolean @default(false)
  requireAverageForCertificate Boolean @default(false)
  minAverage                   Float   @default(7)
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [createdBy], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  certificates Certificate[]
  assessments  Assessment[]
}

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  courseId   String   @db.Uuid
  enrolledAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Module {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  order     Int
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id])
  lessons   Lesson[]
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  order       Int
  videoUrl    String?
  moduleId    String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module   @relation(fields: [moduleId], references: [id])
  progresses  LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  watched     Boolean  @default(false)
  watchedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  totalLessons Int   @default(0)
  averageGrade Float?
  issuedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Assessment {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  order       Int
  courseId    String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions AssessmentSubmission[]

  @@index([courseId])
}

model Question {
  id           String       @id @default(uuid()) @db.Uuid
  assessmentId String       @db.Uuid
  type         QuestionType
  statement    String
  points       Float
  order        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  answers      Answer[]

  @@index([assessmentId])
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@index([questionId])
}

model AssessmentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  assessmentId String           @db.Uuid
  userId       String           @db.Uuid
  status       SubmissionStatus @default(PENDENTE)
  grade        Float?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@unique([assessmentId, userId])
  @@index([userId])
}

model Answer {
  id               String  @id @default(uuid()) @db.Uuid
  submissionId     String  @db.Uuid
  questionId       String  @db.Uuid
  selectedOptionId String? @db.Uuid
  text             String?
  earnedPoints     Float?

  submission       AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question         Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption?      @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([submissionId, questionId])
}
